{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Radio connections, system links, starting at login and installation of signed desktop updates. Update feeds are chosen by the native shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "blec:default",
    "serialplugin:default",
    "opener:default",
    "updater:allow-download",
    "updater:allow-install",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
